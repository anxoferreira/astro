---
export const prerender = false; //esto activa el ssr

import BaseLayout from "../layouts/BaseLayout.astro";

const res = await fetch(new URL("/api/hora", Astro.url));
const datos = await res.json();
---

<BaseLayout>
  <h1>Fecha obtenida usando un api propia</h1>
  <p>La fecha es: {datos.lafecha}</p>
</BaseLayout>
