---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";

const productos = ["portatil", "raton", "teclado"];
const fechahora = new Date().toLocaleString("es-ES");
---

<BaseLayout>
  <h1>Lista de productos usando ssr</h1>
  <p>Fecha y hora: {fechahora}</p>
  <span>esta fecha se calcula al hacer el build</span>
  <ul>
    {productos.map((p) => <li>{p}</li>)}
  </ul>
</BaseLayout>
