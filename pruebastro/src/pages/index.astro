---
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const nombre = "celtics shaq";
const hobbiesShaq = ["Dormir", "Salir", "Entrenar", "Jugar"];

const hobbies = ["fallar tiros libres", "estarmwashed", "Jugar"];
---

<BaseLayout>
  <h1>Mi primera página de astro</h1>
  <p>Yo me llamo {nombre}</p>
  <p>Mis hobbies son:</p>
  <ul>
    {hobbiesShaq.map((hobbie) => <li>{hobbie}</li>)}
  </ul>

  <Button title="Púlsame">Púlsame</Button>

  <Card
    title="Este es shaq"
    description="estoy washed"
    img="https://d2rbybg5ibx87t.cloudfront.net/images/127849/original.jpg?1397061545"
    hobbies={hobbies}
  />
</BaseLayout>
