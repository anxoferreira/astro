---
const title = Astro.props.title;
const descripcion = Astro.props.description;
const hobbies = Astro.props.hobbies;
---

<div class="card">
  <img
    src="https://a.espncdn.com/combiner/i?img=/i/headshots/nba/players/full/614.png"
    alt={title}
    class="card-img"
  />
  <div class="card-body">
    <h3>{title}</h3>
    <p>{descripcion}</p>
    <ul>
      {hobbies.map((hobbie: string) => <li>{hobbie}</li>)}
    </ul>
  </div>
</div>

<style>
  .card {
    max-width: 320px;
    background-color: lightgreen;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    margin: 16px 0;
  }
  .card-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }
  .card-body {
    padding: 20px;
    text-align: left;
  }

  .card-body h3 {
    margin-top: 0;
    margin-bottom: 8px;
    color: #111;
  }
  .card-body p {
    margin-top: 0;
    margin-bottom: 12px;
    color: #333;
  }
  .card-body ul {
    margin: 0;
    padding-left: 20px;
  }
</style>
